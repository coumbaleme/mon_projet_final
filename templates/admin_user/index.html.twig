{% extends 'base.html.twig' %}
{% block title %}Gestion des utilisateurs{% endblock %}
{% block stylesheets %}
{{ parent() }}
<style>
.admin-page { background-color: #729fbd; min-height: 100vh; padding: 2rem 0; }
.table-card-dark { background: #cacbce; border-radius: 16px; overflow: hidden; }
.beautiful-table-dark { border-collapse: separate; border-spacing: 0 8px; }
.beautiful-table-dark thead { background: linear-gradient(to right, #007bff, #6610f2); color: #fff; }
.beautiful-table-dark th { border: none; font-weight: 600; padding: 14px; }
.beautiful-table-dark td { border: none; padding: 12px 14px; }
.beautiful-table-dark tr { background-color: #ffffff; }
.beautiful-table-dark tr:hover { background-color: #f0f4ff; }
.btn-create { background: linear-gradient(to right, #ff6600, #ff9900); color: white; padding: 0.7rem 1.5rem; border-radius: 50px; font-weight: 600; text-decoration: none; }
</style>
{% endblock %}
{% block body %}
<div class="admin-page">
<div class="container my-5">
    <div class="card table-card-dark shadow-lg border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold mb-0">👥 Gestion des utilisateurs</h1>
                <a href="{{ path('app_admin_user_new') }}" class="btn-create">
                    <i class="bi bi-person-plus-fill"></i> Créer un utilisateur
                </a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle table-hover beautiful-table-dark">
                    <thead>
                        <tr>
                            <th>#</th><th>Email</th><th>Vérifié</th>
                            <th class="text-center">Actions</th>
                            <th class="text-center">Supprimer</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td class="text-success">{{ user.email }}</td>
                            <td>
                                {% if user.isVerified %}
                                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i> Oui</span>
                                {% else %}
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i> Non</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-info me-2"><i class="bi bi-eye"></i> Voir</a>
                                <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil-square"></i> Modifier</a>
                            </td>
                            <td class="text-center">{{ include('admin_user/_delete_form.html.twig') }}</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="5" class="text-center py-4">Aucun utilisateur trouvé.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}
